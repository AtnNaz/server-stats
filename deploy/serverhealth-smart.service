[Unit]
Description=Node Stats - SMART disk sağlığı toplayıcı
Documentation=file:///opt/serverhealth/README.md
After=local-fs.target

[Service]
Type=oneshot
# Disklere doğrudan erişim gerektiği için root olarak çalışır; yalnızca /var/lib/serverhealth'e yazabilir.
ExecStart=@NODE@ /opt/serverhealth/bin/collect-smart.js /var/lib/serverhealth/smart.json
StateDirectory=serverhealth
StateDirectoryMode=0755
UMask=0022
Nice=10
IOSchedulingClass=idle

PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
