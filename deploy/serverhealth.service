[Unit]
Description=Sunucu Durumu paneli
Documentation=file:///opt/serverhealth/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=serverhealth
Group=serverhealth
ExecStart=@NODE@ /opt/serverhealth/src/server.js --config /etc/serverhealth/config.json
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# Arayüzden değiştirilen ayarlar ve root yardımcısına giden istek kuyruğu burada durur.
StateDirectory=serverhealth-panel
StateDirectoryMode=0750

# Doğrudan HTTPS için (README'deki "Doğrudan HTTPS" bölümüne bakın):
#LoadCredential=tls.cert:/etc/letsencrypt/live/ornek.com/fullchain.pem
#LoadCredential=tls.key:/etc/letsencrypt/live/ornek.com/privkey.pem

# 443 gibi 1024 altındaki bir portu dinlemek için iki satırı da açın:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

# Sıkılaştırma: servis yalnızca okur, hiçbir şeye yazmaz.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
